generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          BigInt    @id @default(autoincrement())
  title       String
  description String?
  image_url   String?
  github_url  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}
